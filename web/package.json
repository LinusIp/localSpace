{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-libs.mjs",
    "test": "node --test \"packages/**/src/**/*.test.ts\"",
    "typecheck:packages": "tsc --noEmit -p packages/canvas/tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:libs": "node scripts/build-libs.mjs",
    "build:whiteboard": "tsc --noEmit -p surfaces/whiteboard/tsconfig.json && vite build -c surfaces/whiteboard/vite.config.ts",
    "brand:icons": "node scripts/brand-icons.mjs",
    "typecheck:whiteboard": "tsc --noEmit -p surfaces/whiteboard/tsconfig.json"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@types/mdast": "^4.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
