{
  "about": "Where each harness's sources live in this repository, for scripts/hpack.mjs. A repository detail: a package's layout does not depend on it. \"ship\": false keeps a harness out of the package (docs/DECISIONS.md, 2026-10-10); its sources, its in-place build and its tests stay.",
  "harnesses": {
    "io.localspace.whiteboard": {
      "ship": false,
      "manifest": "harnesses/whiteboard",
      "logic": {
        "crate": "harnesses/whiteboard-logic",
        "target": "wasm32-wasip2",
        "artifact": "whiteboard_logic.wasm"
      },
      "files": {
        "ui/web/": {
          "script": "build:whiteboard",
          "out": "harnesses/whiteboard/ui/web"
        }
      }
    },
    "io.localspace.planner": {
      "ship": false,
      "manifest": "registry/planner",
      "logic": {
        "crate": "harnesses/planner-logic",
        "target": "wasm32-wasip2",
        "artifact": "planner_logic.wasm"
      }
    },
    "io.localspace.types": {
      "manifest": "registry/types"
    }
  }
}
